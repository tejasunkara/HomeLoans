{
  "expo": {
    "name": "HomeLoans",
    "slug": "homeloans",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homeloans.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.homeloans.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to scan loan documents.",
          "photosPermission": "Allow $(PRODUCT_NAME) to attach photos of loan documents."
        }
      ],
      "expo-document-picker",
      "expo-font",
      "expo-asset"
    ],
    "scheme": "homeloans",
    "experiments": {
      "typedRoutes": true
    }
  }
}
